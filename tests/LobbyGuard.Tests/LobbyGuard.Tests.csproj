<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/LobbyGuard/LobbyGuard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <!-- The game references aren't copied next to the build, and a test that reads Netcode's types needs them. -->
  <Target Name="CopyNetcode" AfterTargets="Build">
    <ItemGroup>
      <NetcodeFile Include="@(ReferencePath)" Condition="'%(Filename)' == 'Unity.Netcode.Runtime' Or '%(Filename)' == 'Assembly-CSharp' Or '%(Filename)' == 'UnityEngine.CoreModule' Or '%(Filename)' == 'Unity.Collections'" />
    </ItemGroup>
    <Copy SourceFiles="@(NetcodeFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
